package demo;

import java.time.Duration;
import java.util.List;
import org.openqa.selenium.By;
import org.openqa.selenium.Dimension;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;

public class CountOfTextField {

	public static void main(String[] args) throws InterruptedException {

		WebDriver driver = new ChromeDriver();

		driver.manage().window().maximize();
		driver.manage().timeouts().implicitlyWait(Duration.ofSeconds(10));

		// Launch facebook
		driver.get("https://www.facebook.com/");

		// Locate all text fields
		List<WebElement> textfields = driver.findElements(By.tagName("input"));

		// Count text fields
		System.out.println("Number of textfields: " + textfields.size());

		// Get size of first text field
		WebElement textfield = textfields.get(0);

		for(WebElement ele:textfields)
		{
			Dimension text = ele.getSize();
			System.out.println(text);
		}

		// Enter data in first text field
		textfield.sendKeys("Admin");

		Thread.sleep(3000);

		driver.quit();
	}

}
